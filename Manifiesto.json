    "https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.8.0/mammoth.browser.min.js",
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.min.mjs",
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.worker.min.mjs"
  ],
  "curriculum_source": {
    "canonical": "https://raw.githubusercontent.com/lalitoelprofefulanito-dot/curriculo-primaria-nem/main/",
    "complementary": "https://raw.githubusercontent.com/lalitoelprofefulanito-dot/Ecosistema-Curricular-Digital-de-Educaci-n-Primaria-de-la-NEM/main/",
    "essential_files": [
      "version.json",
      "grados.json",
