    "pa_ecosistema_nem_v46"
  ],
  "audit": {
    "date": "2026-09-05",
    "syntax_ok": true,
    "script_blocks": 15,
    "runtime_errors_on_boot": 0,
    "export_escuela_meses_escritos": "11/11",
    "export_escuela_clonaciones": 0,
    "export_planeacion_marcadores_sin_resolver": 0,
    "import_documento_real_meses_reconocidos": "11/11",
    "reset_scoped_to_own_origin_keys": true,
    "reset_preserva_plantillas": true
  },
  "modules": [
    "nexo-01-nucleo-escuela",
    "nexo-02-portal-y-grupo-base",
    "nexo-03-planeacion-didactica",
    "nexo-04-portal-navegacion",
    "nexo-05-planeacion-exportacion",
    "nexo-06-repositorio-curricular",
    "nexo-07-grupo-y-ecosistema",
    "nexo-08-ecosistema-y-autoria",
    "nexo-09-grupo-sesion-y-navegacion",
    "nexo-10-capas-de-escuela",
    "nexo-11-borrado-fuentes-y-version",
    "nexo-12-paridad-tres-etapas",
    "nexo-12a-plantillas-datos",
    "nexo-12b-plantillas-embebidas",
    "nexo-13-arranque"
  ],
  "maintenance_rule": "Toda capa nueva se agrega antes del módulo nexo-13-arranque, nunca después.",
  "intentional_override_chains": {
    "paReturnPortal": "02 -> sustituye 04 -> envuelve 09",
    "pa43Clear": "06 -> envuelve 11",
    "paEnterGroup": "02 -> envuelve 09",
    "matrizEditar": "01 -> envuelve 07",
    "pa44Suggestions": "07 -> envuelve 07",
    "curriculumNotice": "06 -> envuelve 07"
  },
  "local_storage_keys": {
    "escuela": "pa_app_v14",
    "grupo": "pa_group_v49",
    "planeacion": "pa_planning_v36",
    "perfil_escuela": "pa_school_profile_v32",
    "cache_curricular": "pa_curriculum_cache_v43"
  },
  "word_templates_embedded": true,
  "word_templates_note": "Las dos plantillas .docx viajan incrustadas en base64 dentro de index.html (modulo nexo-12a) y se siembran solas en IndexedDB al arrancar y despues de cada Restablecer (modulo nexo-12b). plantilla-programa-analitico.docx sirve a Escuela y a Grupo; plantilla-planeacion-didactica.docx sirve a Planeacion. Cada etapa tiene su propio almacen.",
  "universal_import": {
    "formats": [
      ".docx",
      ".pdf",
      ".txt",
      ".json"
    ],
    "stages": [
      "escuela",
      "grupo",
      "planeacion"
    ],
    "rule": "no sobrescribe lo capturado salvo peticion explicita; no infiere lo que no reconoce",
    "calibrated_against": [
      "plantilla-programa-analitico.docx",
      "plantilla-planeacion-didactica.docx",
      "PROGRAMA_ANALITICO_ESCUELA_2026-2027 (documento real de la escuela)",
      "Modelo de planeacion (documento real de la escuela)"
    ],
    "reads": [
      "etapa 1 por etiquetas",
      "panorama mensual (admite celdas combinadas)",
      "matriz curricular por mes",
      "bloque de cierre mensual (codiseno, orientaciones, evaluacion)",
      "tablas etiqueta-valor de la planeacion"
    ]
  },
  "word_templates": {
    "programa_analitico": {
      "archivo": "plantilla-programa-analitico.docx",
      "etapas": [
        "escuela",
        "grupo"
      ],
      "almacen": "pa_app_v14_templates",
      "mecanismo": "reconocimiento de estructura de tablas",
      "tablas": {
        "contexto": 1,
        "panorama_mensual": 1,
        "matriz": 11,
        "cierre": 11
      }
    },
    "planeacion_didactica": {
      "archivo": "plantilla-planeacion-didactica.docx",
      "etapas": [
        "planeacion"
      ],
      "almacen": "pa_planning_v14_templates",
      "mecanismo": "sustitucion de marcadores {{CAMPO}}",
      "marcadores": 65
    }
  }
}