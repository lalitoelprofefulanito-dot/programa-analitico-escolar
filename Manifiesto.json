      "proyecto-campo.json",
      "proyecto-contenido.json",
      "proyecto-pda.json"
    ]
  },
  "recommended_companions": [
    "README.md"
  ],
  "optional": [
    "manifest.webmanifest",
    "docs/",
    "reports/"
  ],
  "local_storage_prefixes": [
    "pa_",
    "pa46_",
    "nexo_"
  ],
  "indexeddb_databases": [
